# QQBOT 环境变量模板
# 部署时会被复制到 /etc/qqbot/qqbot.env（权限 640），由 systemd 注入

# ===== 必填 =====
# DeepSeek（或其他 OpenAI 兼容接口）的密钥
AI_API_KEY=sk-替换成你的密钥

# ===== 按需修改 =====
AI_API_BASE=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# 管理员 QQ 号（私聊指令鉴权），务必改成你自己的 QQ
ADMIN_ID=0

# NapCat WebSocket 地址：与 compose.yaml 里映射到宿主机的端口一致
ONEBOT_WS_URL=ws://127.0.0.1:3001

# ===== 运行调优 =====
LOG_LEVEL=INFO
EMOJI_DIR=/opt/qqbot/emojis
RECONNECT_INTERVAL=5
