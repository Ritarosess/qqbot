# QQBOT 环境变量模板
# 部署时会被复制到 /etc/qqbot/qqbot.env（权限 640），由 systemd 注入

# ===== 必填 =====
# DeepSeek（或其他 OpenAI 兼容接口）的密钥
AI_API_KEY=sk-替换成你的密钥

# ===== 按需修改 =====
AI_API_BASE=https://api.deepseek.com/v1
AI_MODEL=deepseek-chat

# 管理员 QQ 号（私聊指令鉴权），务必改成你自己的 QQ
ADMIN_ID=0

# NapCat WebSocket 地址：与 compose.yaml 里映射到宿主机的端口一致
ONEBOT_WS_URL=ws://127.0.0.1:3001

# ===== 远程表情仓库（呜哇小站）=====
# 1=启用，[emoji] 会从远程随机取图；0=只用本地素材包
WUWA_EMOJI_ENABLED=1
# 任意 / 全部 = 全站随机角色；也可填具体角色名，如 爱弥斯
WUWA_CHARACTER=任意
# 可选：站点 Token，可提高调用额度（匿名也可用）
WUWA_TOKEN=

# ===== 语音合成（千问平台）=====
# 1=启用 /voice、群内「语音 xxx」「说 xxx」等语音功能
TTS_ENABLED=0
# 千问AI平台 API Key（https://platform.qianwenai.com 获取）
DASHSCOPE_API_KEY=
# 后端模型：cosyvoice-* / qwen-audio-* 走 WebSocket；MiniMax/* 走 HTTP
TTS_MODEL=cosyvoice-v3.5-flash
# 爱弥斯复刻音色（CosyVoice，创建免费）；也可换系统音色如 longanyang
TTS_VOICE=cosyvoice-v3.5-flash-aemeath-59638a19c09243cabf1144ce1be23d28
# 普通聊天回复按概率改用语音（0~1，0 = 关闭，建议 0.05~0.3）
VOICE_REPLY_PROBABILITY=0.25
# 概率语音最大字数（超长自动回退文字，控制费用）
VOICE_MAX_CHARS=120
# 语音触发前缀（逗号分隔）；单字前缀需带分隔符，群里需 @ 或触发词
VOICE_TRIGGER_PREFIXES=语音,说,念,读,朗读,用语音说,发语音,语音回复,读一下,念一下,念一遍,朗读一下,用声音

# ===== 运行调优 =====
LOG_LEVEL=INFO
EMOJI_DIR=/opt/qqbot/emojis
RECONNECT_INTERVAL=5
